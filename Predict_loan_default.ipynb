   ],
   "source": [
    "# ---------------- STEP 5 & 6: BASELINE LOGREG (+ class_weight) ----------------\n",
    "banner(\"STEP 5 & 6 — LOGISTIC REGRESSION BASELINE & IMBALANCE\")\n",
    " \n",
    "logreg_plain = Pipeline([(\"prep\", preprocess),\n",
    "    (\"clf\", LogisticRegression(max_iter=1000, random_state=RANDOM_STATE))])\n",
    "logreg_plain.fit(X_train, y_train)\n",
    "proba_plain, *_ = evaluate(\"LogReg (no class weight)\", logreg_plain, X_test, y_test)\n",
    " \n",
    "logreg_bal = Pipeline([(\"prep\", preprocess),\n",
    "    (\"clf\", LogisticRegression(max_iter=1000, class_weight=\"balanced\", random_state=RANDOM_STATE))])\n",
    "logreg_bal.fit(X_train, y_train)\n",
    "proba_lr, auc_lr, gini_lr, ks_lr = evaluate(\"LogReg (class_weight=balanced)\", logreg_bal, X_test, y_test)\n",
    " \n",
    "print(\"\\n>> NOTE: accuracy barely moves between the two, but recall on defaulters\")\n",
    "print(\">> jumps with class_weight='balanced'. Accuracy is misleading at 8% base rate:\")\n",
    "print(\">> predicting 'never default' would score ~91.5% accuracy and catch ZERO defaults.\")"
   ]
  },
