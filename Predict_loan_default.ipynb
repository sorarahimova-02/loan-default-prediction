   "source": [
    "banner(\"STEP 9 — THRESHOLD SELECTION (asymmetric cost)\")\n",
    "prec, rec, thr = precision_recall_curve(y_test, proba_lr)\n",
    "print(\"Using LogReg(balanced). Precision/Recall at sample thresholds:\")\n",
    "print(f\"{'thresh':>8} {'precision':>10} {'recall':>8}\")\n",
    "for t in [0.3, 0.4, 0.5, 0.6, 0.7]:\n",
    "    pred_t = (proba_lr >= t).astype(int)\n",
    "    tn, fp, fn, tp = confusion_matrix(y_test, pred_t).ravel()\n",
    "    p = tp/(tp+fp) if (tp+fp) else 0\n",
    "    r = tp/(tp+fn) if (tp+fn) else 0\n",
    "    print(f\"{t:>8.2f} {p:>10.3f} {r:>8.3f}   (missed defaulters FN={fn}, false alarms FP={fp})\")\n",
    "print(\"\\n>> A false negative (approve a defaulter) costs far more than a false positive\")\n",
    "print(\">> (reject/flag a good customer). So we LOWER the threshold below 0.5 to raise\")\n",
    "print(\">> recall — catch more defaulters — accepting more false positives in exchange.\")"
   ]
