      ">> partly REFLECTS the outcome. We DROP interest_rate to avoid leakage.\n",
      ">> months_since_last_delinq: missingness is structural (no delinquency history),\n",
      ">> so we DON'T naively impute a number; we add a 'was it missing' flag.\n"
     ]
    }
   ],
   "source": [
    "# ---------------- STEP 3: LEAKAGE CHECK ----------------\n",
    "banner(\"STEP 3 — LEAKAGE CHECK\")\n",
    "num = df.select_dtypes(\"number\").drop(columns=[\"application_id\"])\n",
    "print(\"Correlation with default (abs-sorted):\")\n",
    "print(num.corr()[\"default\"].drop(\"default\").sort_values(key=abs, ascending=False).round(3))\n",
    "print(\"\\ninterest_rate mean by default outcome:\")\n",
    "print(df.groupby(\"default\")[\"interest_rate\"].mean().round(2))\n",
    "print(\"\\n>> interest_rate is the single strongest correlate (~0.51). That is a red flag:\")\n",
    "print(\">> the bank priced the loan partly from its own risk view, so the rate\")\n",
    "print(\">> partly REFLECTS the outcome. We DROP interest_rate to avoid leakage.\")\n",
    "print(\">> months_since_last_delinq: missingness is structural (no delinquency history),\")\n",
    "print(\">> so we DON'T naively impute a number; we add a 'was it missing' flag.\")\n",
    " \n",
    "# Build leakage-aware feature set\n",
    "df[\"msld_missing\"] = df[\"months_since_last_delinq\"].isnull().astype(int)\n",
    "DROP = [\"application_id\", \"interest_rate\", \"default\"]\n",
    "y = df[\"default\"]\n",
    "X = df.drop(columns=DROP)\n",
    " \n",
    "numeric_features = [\"age\",\"annual_income\",\"employment_length\",\"loan_amount\",\n",
    "                    \"dti_ratio\",\"num_open_accounts\",\"num_past_delinquencies\",\n",
    "                    \"credit_score\",\"months_since_last_delinq\",\"msld_missing\"]\n",
    "categorical_features = [\"loan_purpose\",\"home_ownership\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d20d531f-4b28-42d1-9175-4d18e9dfa805",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "======================================================================\n",
      "STEP 4 — PREPROCESSING PIPELINE\n",
      "======================================================================\n",
      "train: (40000, 12)  test: (10000, 12)\n",
      "train default rate: 0.0851  test default rate: 0.0851\n"
     ]
    }
   ],
   "source": [
    "# ---------------- STEP 4: PREPROCESSING (train-only fit via Pipeline) ----------------\n",
    "banner(\"STEP 4 — PREPROCESSING PIPELINE\")\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, stratify=y, random_state=RANDOM_STATE)\n",
    "print(\"train:\", X_train.shape, \" test:\", X_test.shape)\n",
    "print(\"train default rate:\", round(y_train.mean(),4), \" test default rate:\", round(y_test.mean(),4))\n",
    " \n",
    "numeric_pipe = Pipeline([\n",
    "    (\"impute\", SimpleImputer(strategy=\"median\")),\n",
    "    (\"scale\", StandardScaler()),\n",
    "])\n",
    "categorical_pipe = Pipeline([\n",
    "    (\"impute\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\")),\n",
    "])\n",
    "preprocess = ColumnTransformer([\n",
    "    (\"num\", numeric_pipe, numeric_features),\n",
    "    (\"cat\", categorical_pipe, categorical_features),\n",
    "])\n",
    " \n",
    "# ---------------- helpers ----------------\n",
    "def ks_stat(y_true, y_score):\n",
    "    fpr, tpr, _ = roc_curve(y_true, y_score)\n",
    "    return np.max(tpr - fpr)\n",
    " \n",
    "def evaluate(name, model, X_te, y_te):\n",
    "    proba = model.predict_proba(X_te)[:, 1]\n",
    "    pred = (proba >= 0.5).astype(int)\n",
    "    auc = roc_auc_score(y_te, proba)\n",
    "    gini = 2*auc - 1\n",
    "    ks = ks_stat(y_te, proba)\n",
    "    print(f\"\\n--- {name} ---\")\n",
    "    print(f\"ROC-AUC: {auc:.4f} | Gini: {gini:.4f} | KS: {ks:.4f}\")\n",
    "    print(\"Confusion matrix @0.5 threshold:\")\n",
    "    print(confusion_matrix(y_te, pred))\n",
    "    print(classification_report(y_te, pred, digits=3))\n",
    "    return proba, auc, gini, ks"
   ]
  },
